            // システムステータス
            Rectangle {
                horizontal-stretch: 1;
                background: #1a1a2e;
                border-radius: 12px;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000040;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    Text {
                        text: "System Status";
                        color: #ffffff;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    StatusIndicator {
                        label: "System Services";
                        active: system-status;
                    }

                    StatusIndicator {
                        label: "Database";
                        active: database-status;
                    }

                    StatusIndicator {
                        label: "API Server";
                        active: api-status;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // アクションボタン
                    Rectangle {
                        height: 45px;
                        background: #00d4ff;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                // ボタンクリック時の処理
                            }
                        }

                        Text {
                            text: "Refresh Data";
                            color: #0f0f1e;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
